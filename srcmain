    const sz = activeProduct.sizes[sizeIdx];
    const key = `${activeProduct.id}|${sz.l}`;
    setCart((c) => ({
      ...c,
      [key]: {
        qty: (c[key]?.qty || 0) + 1,
        price: sz.p,
        name: activeProduct.name,
        size: sz.l,
        cat: activeProduct.cat,
        photo: activeProduct.photo,
        message,
        remarks,
