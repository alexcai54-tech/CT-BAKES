              ["cart", "Cart", ShoppingCart],
              ["more", "More", Info],
            ].map(([id, label, Icon]) => (
              <button key={id} onClick={() => goTab(id)} className="flex flex-col items-center gap-0.5 relative px-2">
                <Icon size={19} color={activeTab === id ? PINK_DARK : MUTED} />
                {id === "cart" && cartCount > 0 && (
                  <span className="absolute -top-1 right-0 text-[8px] w-3.5 h-3.5 rounded-full flex items-center justify-center text-white" style={{ background: PINK_DARK }}>{cartCount}</span>
                )}
                <span className="text-[9px]" style={{ color: activeTab === id ? PINK_DARK : MUTED, fontWeight: activeTab === id ? 600 : 400 }}>{label}</span>
              </button>
            ))}
          </nav>
        )}
      </div>
    </div>
  );
}
