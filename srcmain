const PROMO_CODES = { CAROL2027: 0.1 }; // code -> discount rate

function currency(n) {
  return `$${n.toFixed(2)}`;
}

function ProductThumb({ cat, photo, size = 22, bg = PALE }) {
  const Icon = CATEGORIES.find((c) => c.id === cat)?.icon || Cake;
  if (photo) {
    return (
      <div className="rounded-xl overflow-hidden flex-shrink-0" style={{ width: size * 2, height: size * 2 }}>
        <img src={photo} alt="" className="w-full h-full object-cover" />
      </div>
    );
  }
  return (
    <div className="rounded-xl flex items-center justify-center flex-shrink-0" style={{ width: size * 2, height: size * 2, background: bg }}>
      <Icon size={size} color={PINK_DARK} />
    </div>
  );
}

function WhiskMark({ size = 40 }) {
  return (
    <svg width={size} height={size} viewBox="0 0 100 100" fill="none">
