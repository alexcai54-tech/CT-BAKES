    setActiveTab("cart");
  };

  const changeQty = (key, delta) => {
    setCart((c) => {
      const next = { ...c };
      if (!next[key]) return c;
      const qty = Math.max(0, next[key].qty + delta);
      if (qty === 0) delete next[key];
      else next[key] = { ...next[key], qty };
      return next;
    });
