      <path d="M58 46 Q66 34 76 30 M58 46 Q62 32 70 24" stroke={INK} strokeWidth="1.5" strokeLinecap="round" />
      <path d="M30 22 l2 6 l6 2 l-6 2 l-2 6 l-2 -6 l-6 -2 l6 -2 z" fill={INK} />
      <circle cx="46" cy="16" r="1.6" fill={INK} />
    </svg>
  );
}

function PillButton({ children, onClick, style, disabled }) {
  return (
    <button
      onClick={onClick}
      disabled={disabled}
      className="w-full py-3 rounded-full font-semibold text-sm disabled:opacity-40"
      style={{ background: PINK, color: "#fff", ...style }}
    >
      {children}
    </button>
  );
}

